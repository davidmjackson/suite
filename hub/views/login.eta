<%~ include("partials/header", { title: "Sign in", bare: true }) %>
<div class="authcard">
  <div class="authleft">
    <div class="waves"></div>
    <div class="brand"><svg class="mk" width="22" height="22" aria-hidden="true"><use href="/illos/glyphs.svg#glyph-suite"/></svg> Sprint Suite</div>
    <div><div class="eyebrow">Sign in</div><p class="authlede">One sign-in, four focused apps.</p></div>
  </div>
  <div class="authright">
    <h1 class="title-lg">Sign in to Sprint Suite</h1>
    <form method="POST" action="/login">
      <% if (it.returnTo) { %><input type="hidden" name="return_to" value="<%= it.returnTo %>"><% } %>
      <div class="field"><label class="label" for="email">Email address</label><input class="input" id="email" name="email" type="email" required autofocus></div>
      <p class="actions"><button class="btn btn-pri" type="submit">Send magic link</button></p>
      <p class="helper">We'll email you a link. No password needed.</p>
    </form>
  </div>
</div>
<%~ include("partials/footer") %>
