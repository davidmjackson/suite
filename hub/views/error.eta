<%~ include("partials/header", { title: it.title || "Error" }) %>
<section class="card is-narrow">
<h1 class="title-lg"><%= it.title || "Something went wrong" %></h1>
<p class="lede"><%= it.message %></p>
<% if (it.reqId) { %><p class="muted reqref">Reference: <%= it.reqId %></p><% } %>
<% if (it.backHref) { %><p><a class="lnk" href="<%= it.backHref %>">Back</a></p><% } %>
</section>
<%~ include("partials/footer") %>
