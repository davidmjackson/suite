<%~ include("partials/header", { title: "Check your email", bare: true }) %>
<div class="authcard">
  <div class="authleft"><div class="waves"></div><div class="brand"><svg class="mk" width="22" height="22" aria-hidden="true"><use href="/illos/glyphs.svg#glyph-suite"/></svg> Sprint Suite</div><div><p class="authlede">Almost there.</p></div></div>
  <div class="authright">
    <h1 class="title-md">Check your email</h1>
    <div class="notice"><span>A sign-in link is on its way to <strong><%= it.email %></strong>. It expires in 15 minutes.</span></div>
    <p><a class="lnk" href="/login">Use a different email</a></p>
  </div>
</div>
<%~ include("partials/footer") %>
